PORT=3002
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
HOTELBEDS_API_KEY=your_hotelbeds_api_key_here
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret_here

# Chatbot agent configuration
# Set to "mock" to bypass the Python process entirely during local development.
# CHATBOT_AGENT_MODE=mock

# When CHATBOT_AGENT_MODE is not "mock", the server will still fall back to the
# lightweight mock responses if the Python agent cannot be reached. Set this to
# "error" to disable that behavior.
# CHATBOT_AGENT_FALLBACK=mock

# Optional overrides for the Python process
# CHATBOT_AGENT_TIMEOUT_MS=120000
# CHATBOT_PYTHON_BIN=/absolute/path/to/python3
# CHATBOT_PYTHON_MODULE=api.crewai_agents.chatbot_crew
